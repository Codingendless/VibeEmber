[Unit]
Description=VibeEmber account and publishing API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/vibe-ember-api/current
EnvironmentFile=/etc/vibe-ember-api.env
ExecStart=/usr/bin/python3 /opt/vibe-ember-api/current/app.py
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vibe-ember
NoNewPrivileges=true
MemoryMax=160M

[Install]
WantedBy=multi-user.target
